4d\u8d39 | \u4f18\u5316\u4fe1\u62ab\u3001\u66f4\u65b0ESG\u6807\u51c6\u3001\u5168\u5e74\u51cf\u8d39\u7ea611.13\u4ebf\u5143 | \u964d\u4f4e\u8fd0\u884c\u6210\u672c\uff0c\u63d0\u5347\u6cbb\u7406\u900f\u660e\u5ea6 |\n| \u4ea7\u54c1\u4e0e\u670d\u52a1 | \u5b8c\u5584\u201c\u56fa\u6536+\u201d\u6307\u6570\u3001\u5347\u7ea7\u671f\u6743\u4e13\u533a\u3001\u201c\u4e00\u7f51\u901a\u529e\u201d | \u4e30\u5bcc\u6295\u8d44\u5de5\u5177\uff0c\u4f18\u5316\u670d\u52a1\u4f53\u9a8c |\n| \u5f00\u653e\u4e0e\u76d1\u7ba1 | \u5bf9\u63a5\u8fd140\u5bb6\u6d77\u5916\u673a\u6784\u3001\u201c\u63d0\u8d28\u589e\u6548\u91cd\u56de\u62a5\u201d2.0 | \u5438\u5f15\u957f\u7ebf\u8d44\u91d1\uff0c\u5f3a\u5316\u4e0a\u5e02\u516c\u53f8\u8d28\u91cf |\n\n## \u7efc\u5408\u7814\u5224\n\u7efc\u5408\u6765\u770b\uff0cSSE\u6b63\u4ee5\u6570\u5b57\u5316\u670d\u52a1\u5347\u7ea7\u3001\u7ed3\u6784\u6027\u964d\u8d39\u4e0eESG\u6cbb\u7406\u6df1\u5316\u7cfb\u7edf\u6027\u4f18\u5316\u5e02\u573a\u751f\u6001\u3002\u5728\u5b58\u91cf\u535a\u5f08\u4e0e\u4f30\u503c\u5206\u5316\u80cc\u666f\u4e0b\uff0c\u76d1\u7ba1\u575a\u6301\u201c\u91cd\u8d28\u91cf\u3001\u5f3a\u56de\u62a5\u201d\u5bfc\u5411\uff0c\u4e2d\u957f\u671f\u5c06\u6709\u6548\u5f15\u5bfc\u957f\u7ebf\u8d44\u91d1\u5165\u5e02\uff0c\u63d0\u5347\u5e02\u573a\u6574\u4f53\u97e7\u6027\u4e0e\u56fd\u9645\u914d\u7f6e\u5438\u5f15\u529b\u3002\n\n## \u53c2\u8003\u6587\u732e\n\n<a id=\"ref-1\"></a>**[1]** cn.chinadaily.com.cn \u2014 \u4f26\u6566\u8bc1\u5238\u4ea4\u6613\u6240\u96c6\u56e22026\u5e02\u573a\u5c55\u671b\u8bba\u575b\u5728\u4e0a\u6d77\u4e3e\u529e - \u4e2d\u56fd\u65e5\u62a5\u7f51\nURL: https://cn.chinadaily.com.cn/a/202604/16/WS69e080a2a310942cc49a7e5b.html\n\u539f\u6587\u7247\u6bb5\uff1a\u300c\u4f26\u6566\u8bc1\u5238\u4ea4\u6613\u6240\u96c6\u56e22026\u5e02\u573a\u5c55\u671b\u8bba\u575b\u5728\u4e0a\u6d77\u4e3e\u529e - \u4e2d\u56fd\u65e5\u62a5\u7f51 \u4f26\u6566\u8bc1\u5238\u4ea4\u6613\u6240\u96c6\u56e22026\u5e02\u573a\u5c55\u671b\u8bba\u575b\u5728\u4e0a\u6d77\u4e3e\u529e \u7ad9\u5185\u641c\u7d2