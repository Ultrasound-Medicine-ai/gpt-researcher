OPENAI_API_KEY=
# Alibaba Cloud Model Studio / DashScope.  The Smart model will automatically
# Each role moves to the next entry in its FALLBACKS after a quota or API failure.
# DASHSCOPE_API_KEY=
# Speed-oriented Matpool models (OpenAI-compatible; measured low latency):
# FAST_LLM=matpool:DeepSeek-V4-Flash
# FAST_LLM_FALLBACKS=matpool:Qwen-Plus,matpool:Doubao-Seed-2.0-Mini
# Chat intent uses FAST_LLM by default. Override only when routing needs a separate model.
# CHAT_INTENT_ROUTER_ENABLED=true
# CHAT_INTENT_CONFIDENCE_THRESHOLD=0.75
# CHAT_INTENT_ROUTER_TIMEOUT_SEC=12
# CHAT_INTENT_ROUTER_MODEL=
# CHAT_INTENT_ROUTER_PROVIDER=
# SMART_LLM=matpool:Qwen-Plus
# SMART_LLM_FALLBACKS=matpool:DeepSeek-V4-Flash,matpool:Doubao-Seed-2.0-Lite
# STRATEGIC_LLM=matpool:DeepSeek-V4-Flash
# STRATEGIC_LLM_FALLBACKS=matpool:Qwen-Plus,matpool:Doubao-Seed-2.0-Mini
# Or DashScope:
# FAST_LLM=dashscope:deepseek-r1-distill-qwen-7b
# SMART_LLM=dashscope:qwen3.6-plus
# STRATEGIC_LLM=dashscope:glm-5
# EMBEDDING=dashscope:text-embedding-v2
TAVILY_API_KEY=
# Comma-separated Tavily keys for automatic failover when a key hits monthly quota.
# TAVILY_API_KEY is kept for backward compatibility; the first key here is used if both are set.
# TAVILY_API_KEYS=tvly-dev-key-1,tvly-dev-key-2
XQUIK_API_KEY=
DOC_PATH=./my-docs

# Browser-facing API (WebSocket). Inside Docker Next.js, keep localhost:8000.
# NEXT_PUBLIC_GPTR_API_URL=http://localhost:8000
# Server-side Next.js → API (Docker Compose service name; do NOT use localhost here).
# GPTR_BACKEND_URL=http://gpt-researcher:8000

# Scraper Configuration
# ---------------------
# Control concurrent scraping and rate limiting to respect API limits

# Maximum concurrent scraper workers (simultaneous operations)
# Adjust based on your scraper service limits:
#   - Firecrawl Free: 2 concurrent browsers
#   - Firecrawl Hobby: 5 concurrent browsers
#   - BeautifulSoup/other scrapers: Set based on target site limits
# Default: 15 (may be too high for rate-limited APIs)
#MAX_SCRAPER_WORKERS=15

# Rate limiting: minimum seconds between scraper requests
# Controls request frequency to avoid exceeding API rate limits
# Calculate as: 60 / requests_per_minute
# Examples:
#   - Firecrawl Free (10 req/min): 6.0 seconds
#   - Firecrawl /scrape (10 req/min): 6.0 seconds
#   - Custom API (30 req/min): 2.0 seconds
#   - No rate limit: 0 (default)
# Note: Works with all scrapers (firecrawl, bs, browser, etc.)
# Default: 0.0 (no rate limiting)
#SCRAPER_RATE_LIMIT_DELAY=0.0

# Performance Optimization
# ------------------------
# Smart context compression: Skip expensive embedding-based filtering for small documents
# When scraped content is already concise, directly use it instead of running compression pipeline
# This can reduce latency by 40-50% for queries with small result sets
# Default: 8000 characters (8KB threshold)
#COMPRESSION_THRESHOLD=8000

# LangChain Tracing (LangSmith) - Enable for enhanced observability
# To enable tracing, uncomment the following lines and provide your API Key

# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT="gpt-researcher"

# Token Limits
# ------------
# Maximum output tokens per LLM call. Leaving unset uses package defaults
# (FAST=3000, SMART=6000, STRATEGIC=4000) suited to GPT-4o-class models.
# Modern long-output models (Claude 4.x, GPT-5) truncate reports at
# these defaults.
#
# Recommended values by model class:
#   GPT-4o family (16k max output):   SMART_TOKEN_LIMIT=8000
#   Claude Haiku 4.5 (64k max):       SMART_TOKEN_LIMIT=16000
#   Claude Sonnet 4.6 (64k max):      SMART_TOKEN_LIMIT=16000
#   Claude Opus 4.7 (128k max):       SMART_TOKEN_LIMIT=32000
#   GPT-5 family (128k max):          SMART_TOKEN_LIMIT=32000
#
# FAST_TOKEN_LIMIT=8000
# SMART_TOKEN_LIMIT=16000
# STRATEGIC_TOKEN_LIMIT=16000

# Citation style for research_report: numbered ([1][2] + 参考文献) or apa (hyperlinks)
CITATION_STYLE=numbered
# Post-process [n] only when the model emitted no inline cites (never overrides good output)
# DETERMINISTIC_CITE=true

# ---------------------------------------------------------------------------
# Optional small-scale SaaS persistence
# Leave unset to keep legacy JSON/local mode — report quality path unchanged.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://gptr:gptr@localhost:5432/gptr
# Docker Compose uses service-network addresses by default. Set these only when
# its API/worker should connect to externally managed services.
# DOCKER_DATABASE_URL=postgresql://gptr:gptr@postgres:5432/gptr
# DOCKER_REDIS_URL=redis://redis:6379/0
# REDIS_URL=redis://localhost:6379/0
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=gptr-artifacts
# MINIO_SECURE=false
# PGVECTOR_CONNECTION_STRING=postgresql+psycopg://gptr:gptr@localhost:5432/gptr

# Security / worker limits
# MAX_UPLOAD_BYTES=20971520
# MAX_UPLOADS_PER_DIR=50
# RESEARCH_JOB_TIMEOUT_SEC=1800
# RESEARCH_JOB_MAX_ATTEMPTS=3
# RESEARCH_JOB_STALE_SEC=90
# RESEARCH_HEARTBEAT_INTERVAL_SEC=15
# RESEARCH_JOB_REAPER_INTERVAL_SEC=30
# Hard budgets (prevent runaway spend; clamps UI total_words)
# RESEARCH_MAX_TOTAL_SEARCHES=6
# RESEARCH_MAX_OUTPUT_WORDS=1800
# RESEARCH_MAX_SUBTOPICS=2
# RESEARCH_MAX_LLM_CALLS=24
# RESEARCH_CHAPTER_PARALLELISM=2
# MCP_ALLOW_USER_STDIO=false
# DETERMINISTIC_CITE=true
#
# Async Job path (UI: POST /api/jobs/research + poll GET /api/jobs/{id})
# DATABASE_URL + REDIS_URL required. Worker: arq jobs.worker.WorkerSettings
# ENV=production
# ENABLE_ASYNC_RESEARCH_JOBS=true
# ENABLE_WS_START_RESEARCH=false
# ALLOW_IN_PROCESS_RESEARCH_FALLBACK=false
# ARQ_MAX_JOBS=2
# Concurrency / rate limits (create returns 429 + Retry-After when exceeded)
# RESEARCH_MAX_CONCURRENT_PER_USER=1
# RESEARCH_MAX_CONCURRENT_GLOBAL=2
# RESEARCH_MAX_QUEUE_DEPTH=2
# RESEARCH_DAILY_MAX_SEARCHES=50
# RESEARCH_DAILY_MAX_LLM_CALLS=200
# RESEARCH_SLOT_LEASE_SEC=2100
# RESEARCH_LIMIT_RETRY_AFTER_SEC=60
# Report writing resilience
# RESEARCH_LLM_CONTINUE_MAX=2
# RESEARCH_CHAPTER_MAX_ATTEMPTS=2
# SMART_LLM_FALLBACKS=dashscope:glm-5,dashscope:qwen3-32b,dashscope:deepseek-r1-distill-qwen-7b
# Embedding failover (primary EMBEDDING then EMBEDDING_FALLBACKS).
# Only list text models with the SAME output dim as EMBEDDING_DIM / pgvector.
# Do NOT mix ollama:nomic-embed-text (768) when EMBEDDING_DIM=1536 — wrong-dim
# vectors fail ingest and still burn embed latency. If all candidates fail,
# RAG degrades to FTS/keyword instead of failing the Job.
# Matpool OpenAI-compatible embeddings (example: Text-Embedding-V4 @ 1024-d)
# MATPOOL_API_KEY=
# MATPOOL_BASE_URL=https://token.matpool.com/v1
# EMBEDDING_DIM=1024
# EMBEDDING=matpool:Text-Embedding-V4
# EMBEDDING_FALLBACKS=
# Or DashScope (must match EMBEDDING_DIM / pgvector):
# EMBEDDING=dashscope:text-embedding-v1
# EMBEDDING_FALLBACKS=dashscope:text-embedding-v2
# Dependency resilience (search / scrape / embed)
# RESEARCH_TAVILY_SEARCH_TIMEOUT_SEC=12
# RESEARCH_SCRAPE_URL_TIMEOUT_SEC=8
# RESEARCH_SCRAPE_URL_RETRIES=0
# BROWSE_CHUNK_MAX_LENGTH=3072
# MAX_CONTENT_CHARS=8000
# COMPRESSION_THRESHOLD=8000
# RESEARCH_SEARCH_CIRCUIT_FAILURES=4
# RESEARCH_SEARCH_CIRCUIT_COOLDOWN_SEC=90
# RESEARCH_SCRAPE_CIRCUIT_FAILURES=8
# RESEARCH_EMBED_CIRCUIT_FAILURES=3
# Hybrid RAG (documents / document_chunks parent-child)
# RAG_TOP_K=8
# RAG_CHILD_TOKENS_MIN=300
# RAG_CHILD_TOKENS_MAX=600
# RAG_CONTEXT_TOKEN_BUDGET=3500
# RAG_RERANKER_ENABLED=false
# RAG_RERANKER=dashscope:qwen3-rerank
# After web scrape: ingest → Hybrid retrieve → fixed Evidence Pack for Writer
# (compress becomes a light preview when this is on). Citations still use
# research_sources raw_content. Fail → keep compress join context.
# WEB_RAG_EVIDENCE_PACK=true
# WEB_RAG_CONTEXT_BUDGET=6000
# WEB_RAG_TOP_K=10

# Planning intent: inject recent chat/report signals; clarify ambiguous acronyms
# (e.g. SSE = Server-Sent Events vs Shanghai Stock Exchange) before Job create.
# RESEARCH_USER_PLANNING_CONTEXT=true
# RESEARCH_AMBIGUITY_PREFERENCE=tech
# RESEARCH_INTENT_CLARIFY=true

# Trusted report pipeline (plan → evidence/claim → constrained write → audit)
# Safe runway (not a replacement of legacy):
#   Phase A Shadow 5%: ENABLED=true SHADOW=true GRAY=5 FALLBACK=true
#     → ~5% tasks dual-write; users still get legacy report
#   Phase B Gray 5%:   ENABLED=true SHADOW=false GRAY=5 FALLBACK=true
#     → ~5% tasks deliver trusted; rest stay legacy
# Default OFF. Gray buckets by job_id (per-task). Unset GRAY = 100% of enabled.
# TRUSTED_REPORT_PIPELINE_ENABLED=false
# TRUSTED_REPORT_SHADOW_MODE=false
# TRUSTED_REPORT_FALLBACK_TO_LEGACY=true
# TRUSTED_REPORT_GRAY_PERCENT=5
# Local review only — allows scripts to force_trusted_sample on a job payload
# TRUSTED_REPORT_ALLOW_FORCE_SAMPLE=false
# TRUSTED_REPORT_ANOMALY_STREAK=3
# TRUSTED_REPORT_KILL_MINUTES=60

# Visitor identity — signed HttpOnly cookie (API ignores forgeable X-User-Id)
# VISITOR_COOKIE_SECRET=replace-me
# VISITOR_COOKIE_NAME=gptr_uid
# VISITOR_COOKIE_MAX_AGE_SEC=31536000
# Set true only behind HTTPS; local HTTP/Next BFF must leave this unset/false.
# VISITOR_COOKIE_SECURE=false
# ALLOW_TEST_USER_HEADERS=false
# TRUSTED_PLANNER_TOKEN_BUDGET=2500
# TRUSTED_SECTION_EVIDENCE_TOKEN_BUDGET=1800
# TRUSTED_SECTION_TOP_K=8
# TRUSTED_MIN_CITATION_COVERAGE_PCT=85
# TRUSTED_RELEASE_MAX_P95_MS=0
# TRUSTED_RELEASE_MAX_COST_UNITS=0

# Report length default (overridden by UI Preferences -> Report Length;
# hard-capped by RESEARCH_MAX_OUTPUT_WORDS)
# TOTAL_WORDS=1200

# Academic / scholarly search (configure retrievers here, not in the UI)
# Examples: tavily | tavily,openalex,arxiv | tavily,semantic_scholar
# RETRIEVER=tavily,openalex,arxiv
